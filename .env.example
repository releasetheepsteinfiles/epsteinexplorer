# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://explorer:explorer@db:5432/epsteinexplorer

# ── LLM (via LiteLLM) ────────────────────────────────────────
# Default: Google Gemini. Change LLM_MODEL and the matching
# API key env var to use another provider.
#
# Provider examples:
#   gemini/gemini-2.0-flash     → set GEMINI_API_KEY
#   gpt-4o-mini                 → set OPENAI_API_KEY
#   anthropic/claude-sonnet-4-20250514   → set ANTHROPIC_API_KEY
#
LLM_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=your-google-api-key-here

# Generic LiteLLM key (used when the provider needs it)
LITELLM_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
