# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://explorer:explorer@db:5432/epsteinexplorer

# ── LLM (via LiteLLM + OpenRouter) ───────────────────────────
# All models are routed through OpenRouter.
# Browse available models at https://openrouter.ai/models
#
# Model examples:
#   openrouter/google/gemini-2.0-flash-001   (default, fast & cheap)
#   openrouter/google/gemini-2.5-pro-preview-05-06
#   openrouter/anthropic/claude-sonnet-4-20250514
#   openrouter/openai/gpt-4o
#   openrouter/meta-llama/llama-4-maverick
#
LLM_MODEL=openrouter/google/gemini-2.0-flash-001
OPENROUTER_API_KEY=your-openrouter-api-key-here
EPSTEIN_CACHE_TTL_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
